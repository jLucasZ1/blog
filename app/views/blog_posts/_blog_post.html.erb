<%= link_to blog_post, class: "block w-full h-auto rounded-lg bg-gray-200 flex flex-col transition-transform transform hover:scale-105 hover:shadow-lg" do %>
  <% if blog_post.banner_image.attached? %>
    <%= image_tag blog_post.banner_image, class: "h-64 object-cover rounded-t-lg pointer-events-none" %>
  <% else %>
    <%= image_tag "", class: "h-64 object-cover rounded-t-lg pointer-events-none" %>
  <% end %>

  <div class="px-4 py-2">
    <p class="text-xl text-gray-900 overflow-hidden font-semibold">
      <%= blog_post.title %>
    </p>
  </div>
<% end %>